# Copy to .env.local and fill in local values. Never commit real secrets.
DATABASE_URL=postgresql://mofe@127.0.0.1:5433/mofe
BETTER_AUTH_SECRET=replace-with-32-byte-hex
BETTER_AUTH_URL=http://localhost:3000
MANAGER_EMAIL=manager@mofe.local
MANAGER_PASSWORD=choose-a-dev-password
# Optional live payments. Without this, the app uses the mock provider (no real money).
PAYSTACK_SECRET_KEY=
# Optional transactional email. Without this, emails are skipped (logged).
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
# Optional R2 file storage. Local disk is used unless STORAGE_BACKEND=r2.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=mofe-beauty
R2_PUBLIC_URL=
STORAGE_BACKEND=local
# Dev-only staff logins created by `npm run db:seed` (local only).
STAFF_PASSWORD=choose-a-dev-password
