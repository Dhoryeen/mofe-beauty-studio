  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:start": "\"C:\\Program Files\\PostgreSQL\\18\\bin\\pg_ctl.exe\" -D \"%LOCALAPPDATA%\\mofe-pgdata\" -l \"%LOCALAPPDATA%\\mofe-pgdata\\server.log\" start",
    "db:stop": "\"C:\\Program Files\\PostgreSQL\\18\\bin\\pg_ctl.exe\" -D \"%LOCALAPPDATA%\\mofe-pgdata\" stop",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env.local db/migrate.ts",
    "db:seed": "tsx --env-file=.env.local db/seed.ts",
    "db:setup": "npm run db:generate && npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
